# Files that belong in the repository but not in a distributed plugin zip.
# `git archive` honours these, so a release build is:
#   git archive --format=zip --prefix=author-bio/ -o author-bio.zip <tag>
/.gitattributes   export-ignore
/.gitignore       export-ignore
/.superpowers     export-ignore
/.impeccable      export-ignore
/docs             export-ignore
/CLAUDE.md        export-ignore
/PRODUCT.md       export-ignore
/DESIGN.md        export-ignore
